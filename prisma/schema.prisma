generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id    Int     @id @default(autoincrement())
  username String @unique
  name String?
  email String @unique
  isVerified Boolean @default(false)
  password Password?
  tokens Tokens[]
  meetings Meetings[]
}

model Password {
  id Int @id @default(autoincrement())
  hash String
  userId Int @unique
  user User @relation(fields: [userId], references: [id])
}

model Tokens {
  id Int @id @default(autoincrement())
  token String
  Jwt Boolean @default(false)
  session Boolean @default(false)
  userId Int
  user User @relation(fields: [userId], references: [id])
}

model Meetings {
  id Int @id @default(autoincrement())
  title String
  description String?
  date DateTime
  time String
  location String?
  platform Platform
  platform_link String? @unique
  userId Int
  user User @relation(fields: [userId], references: [id])
}

enum Platform {
  ZOOM
  TEAMS
  GOOGLE_MEET
}